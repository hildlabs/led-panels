[Unit]
Description=LED Panel Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/led-panel-dashboard
Environment=LED_DASHBOARD_PORT=8787
Environment=LED_BRIDGE_URL=http://pc.local:8765
ExecStart=%h/led-panel-dashboard/.venv/bin/python %h/led-panel-dashboard/server/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
